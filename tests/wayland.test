# Generated key events

test wayland-10.1 {generated key events} -constraints {
    wayland
} -setup {
    toplevel .t
    entry .t.e
    pack .t.e
    waitShown .t
    focus -force .t.e
    update
    set ::wlkeys {}
    bind .t.e <Key> {lappend ::wlkeys %K %A}
} -body {
    event generate .t.e <Key-a>
    event generate .t.e <Key-A>
    event generate .t.e <Key-odiaeresis>
    event generate .t.e <Key-space>
