# Bidirectional text

test wayland-7.1 {right-to-left text is measured as a whole} -constraints {
    wayland bidi
} -body {
    set s "שלום עולם"
    expr {[font measure TkDefaultFont $s] > 0
	    && [font measure TkDefaultFont $s]
	    == [font measure TkDefaultFont [string reverse $s]]}
} -result 1
test wayland-7.2 {Arabic is shaped: joined letters are narrower} -constraints {
    wayland bidi
} -body {
    set joined [font measure TkDefaultFont "مرحبا"]
    set isolated 0
    foreach c [split "مرحبا" ""] {
	incr isolated [font measure TkDefaultFont $c]
    }
    expr {$joined < $isolated}
} -result 1
test wayland-7.3 {mixed text in widgets} -constraints {
    wayland bidi
} -setup {
    toplevel .t
    entry .t.e
    text .t.t -width 30 -height 3
    canvas .t.c -width 100 -height 100
    pack .t.e .t.t .t.c
} -body {
    .t.e insert 0 "abc שלום def ١٢٣"
    .t.t insert end "price 100 السعر ١٠٠ end\nשלום"
    .t.c create text 50 50 -text "مرحبا Tk" -angle 45
    waitShown .t
    .t.e icursor 5
    .t.e selection range 2 8
    .t.t tag add sel 1.3 1.12
    update
    list [.t.e index insert] [llength [.t.c bbox all]] [stillConnected]
} -cleanup {
    destroy .t
} -result {5 4 1}

