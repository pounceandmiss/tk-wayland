    unset -nocomplain ::wlkeys
} -result {{a a A A ö ö space { }} {aAö }}

# Random sequences of operations

test wayland-13.1 {random window operations} -constraints {
    wayland
} -setup {
    expr {srand([testSeed 4242])}
    proc pick {list} {
	lindex $list [expr {int(rand() * [llength $list])}]
    }
    proc tops {} {
	lmap w [winfo children .] {
	    if {[string match .wls* $w]} {set w} continue
	}
    }
} -body {
    set n 0
    for {set i 0} {$i < 500} {incr i} {
	set t [pick [tops]]
	set op [pick {create destroy withdraw deiconify iconify resize
		override menu unpost tooltip alpha update}]
	if {$t eq "" && $op ne "update"} {
	    set op create
	}
	switch $op {
	    create {
		set t .wls[incr n]
		toplevel $t
		menu $t.m -tearoff 0
		$t.m add command -label One
	    }
	    destroy {destroy $t}
	    withdraw {wm withdraw $t}
	    deiconify {wm deiconify $t}
	    iconify {catch {wm iconify $t}}
	    resize {
		wm geometry $t [expr {50 + int(rand() * 300)}]x[expr {30 + int(rand() * 200)}]
	    }
	    override {
		wm overrideredirect $t [expr {![wm overrideredirect $t]}]
		wm withdraw $t
		wm deiconify $t
	    }
	    menu {catch {$t.m post [winfo rootx $t] [winfo rooty $t]}}
	    unpost {catch {$t.m unpost}}
	    tooltip {
		set tip $t.tip[incr n]
		toplevel $tip
		wm overrideredirect $tip 1
		after [expr {int(rand() * 100)}] [list destroy $tip]
	    }
	    alpha {wm attributes $t -alpha [expr {rand()}]}
	    update {update}
	}
	if {rand() < 0.3} {
	    update
	}
    }
    update
    destroy {*}[tops]
    stillConnected
} -cleanup {
    destroy {*}[tops]
    rename pick {}
    rename tops {}
} -result 1
test wayland-13.2 {random window manager operations} -constraints {
    wayland
} -setup {
    expr {srand([testSeed 2718])}
    proc pick {list} {
	lindex $list [expr {int(rand() * [llength $list])}]
    }
    proc size {max} {
	expr {int(rand() * $max)}
    }
    proc tops {} {
	lmap w [winfo children .] {
	    if {[string match .wlm* $w]} {set w} continue
	}
    }
    image create photo wlmIcon -width 16 -height 16
    wlmIcon put red -to 0 0 16 16
    set screenWidth [winfo screenwidth .]
    set screenHeight [winfo screenheight .]
} -body {
    set n 0
    for {set i 0} {$i < 400} {incr i} {
	set t [pick [tops]]
	set op [pick {create destroy withdraw deiconify iconify geometry
		minsize maxsize fullscreen zoomed resizable transient title
		icon update}]
	if {$t eq "" && $op ne "update"} {
	    set op create
	}
	switch $op {
	    create {
		toplevel .wlm[incr n]
	    }
	    destroy {destroy $t}
	    withdraw {wm withdraw $t}
	    deiconify {wm deiconify $t}
	    iconify {catch {wm iconify $t}}
	    geometry {
		set width [expr {1 + [size [expr {$screenWidth + 300}]]}]
		set height [expr {1 + [size [expr {$screenHeight + 300}]]}]
		wm geometry $t ${width}x$height
	    }
	    minsize {
		wm minsize $t [size [expr {$screenWidth + 200}]] \
			[size [expr {$screenHeight + 200}]]
	    }
	    maxsize {
		wm maxsize $t [size [expr {$screenWidth + 200}]] \
			[size [expr {$screenHeight + 200}]]
	    }
	    fullscreen - zoomed {
		set on [wm attributes $t -$op]
		wm attributes $t -$op [expr {!$on}]
	    }
	    resizable {
		wm resizable $t [pick {0 1}] [pick {0 1}]
	    }
	    transient {
		# A window cannot be the container of itself.
		catch {wm transient $t [pick [concat {{}} [tops]]]}
	    }
	    title {
		wm title $t [pick [list "" "Title" "שלום ✓ \U1F600" \
			[string repeat x 300]]]
	    }
	    icon {wm iconphoto $t wlmIcon}
	    update {update}
	}
	if {rand() < 0.3} {
	    update
	}
    }
    update
    destroy {*}[tops]
    stillConnected
} -cleanup {
    destroy {*}[tops]
    image delete wlmIcon
    rename pick {}
    rename size {}
    rename tops {}
    unset -nocomplain screenWidth screenHeight width height on
} -result 1

# Input from the compositor (waylandInput, swayPointer)

test wayland-11.1 {typing} -constraints {
    waylandInput
} -setup {
    toplevel .t
    wm title .t wltyping
    entry .t.e
    pack .t.e
    waitShown .t
    focusOn .t.e
} -body {
    type "Wayland ü ✓ \U1F600"
    waitFor {[string length [.t.e get]] >= 14}
    .t.e get
} -cleanup {
    destroy .t
} -result "Wayland ü ✓ \U1F600"
test wayland-11.2 {the clipboard is given to other clients} -constraints {
    waylandInput
} -setup {
    toplevel .t
    entry .t.e
    pack .t.e
    waitShown .t
    focusOn .t.e
    type
    update
} -body {
    clipboard clear
    clipboard append "from Tk ✓"
    update

    # wl-paste gets the data from this application, which must process its
    # events meanwhile.
    set file [makeFile {} wlpaste.txt]
    set pid [exec wl-paste --no-newline > $file &]
    waitFor {[catch {exec kill -0 $pid}]}
    set f [open $file]
    fconfigure $f -encoding utf-8
    set result [read $f]
    close $f
    set result
} -cleanup {
    destroy .t
    removeFile wlpaste.txt
} -result "from Tk ✓"
test wayland-11.3 {the clipboard and the primary selection of other clients} -constraints {
    waylandInput
} -body {
    exec wl-copy "clipboard ✓"
    exec wl-copy --primary "primary ✓"
    after 200
    update
    list [clipboard get] [selection get]
} -result {{clipboard ✓} {primary ✓}}
test wayland-11.4 {other clients take the clipboard: SelectionClear} -constraints {
    waylandInput
} -setup {
    toplevel .t
    entry .t.e
    pack .t.e
    .t.e insert 0 "selected"
    waitShown .t
    focusOn .t.e
    type
    update
} -body {
    .t.e selection range 0 end
    update
    exec wl-copy --primary "other"
    waitFor {![.t.e selection present]}
    .t.e selection present
} -cleanup {
    destroy .t
} -result 0
test wayland-12.1 {click a button} -constraints {
    swayPointer
} -setup {
    toplevel .t
    wm title .t wlclick
    set ::wlclicked 0
    button .t.b -text Click -command {incr ::wlclicked}
    pack .t.b -padx 20 -pady 20
    waitShown .t
} -body {
    swayClick .t.b 10 10
    waitFor {$::wlclicked}
    set ::wlclicked
} -cleanup {
    destroy .t
    unset -nocomplain ::wlclicked
} -result 1
test wayland-12.2 {a menu is dismissed by a click outside} -constraints {
    swayPointer
} -setup {
    toplevel .t
    wm title .t wlmenu
    menubutton .t.mb -text Menu -menu .t.mb.m
    menu .t.mb.m -tearoff 0
    .t.mb.m add command -label One
    pack .t.mb -padx 50 -pady 50
    waitShown .t
} -body {
    swayClick .t.mb 5 5
    set posted [waitFor {[winfo ismapped .t.mb.m]}]
    after 200
    swayClick .t 2 [expr {[winfo height .t] - 2}]
    list $posted [expr {![waitFor {![winfo ismapped .t.mb.m]}]}]
} -cleanup {
    destroy .t
} -result {1 0}
test wayland-12.3 {a menu entry is invoked by a click} -constraints {
    swayPointer
} -setup {
    toplevel .t
    wm title .t wlinvoke
    set ::wlinvoked 0
    menubutton .t.mb -text Menu -menu .t.mb.m
    menu .t.mb.m -tearoff 0
    .t.mb.m add command -label One -command {incr ::wlinvoked}
    pack .t.mb -padx 50 -pady 50
    waitShown .t
} -body {
    swayClick .t.mb 5 5
    waitFor {[winfo ismapped .t.mb.m]}
    after 200
    swayClick .t.mb 5 [expr {[winfo height .t.mb] + 8}]
    waitFor {$::wlinvoked}
    set ::wlinvoked
} -cleanup {
    destroy .t
    unset -nocomplain ::wlinvoked
} -result 1
test wayland-14.1 {::tk::wayland commands: bad arguments} -constraints {
    wayland
} -setup {
    frame .f
} -body {
    set result {}
    foreach command {
	{appid} {appid .f} {appid .nonesuch} {appid . a b}
	{decorations . bogus} {decorations}
	{startmove} {startresize .} {startresize . q} {windowmenu . 1}
	{windowmenu . a b} {inhibitidle . maybe} {activationtoken x}
	{scale} {corners}
    } {
	catch {::tk::wayland::[lindex $command 0] {*}[lrange $command 1 end]} m
	lappend result $m
    }
    join $result \n
} -cleanup {
    destroy .f
} -result {wrong # args: should be "::tk::wayland::appid window ?id?"
window ".f" isn't a top-level window
bad window path name ".nonesuch"
wrong # args: should be "::tk::wayland::appid window ?id?"
bad mode "bogus": must be server or none
wrong # args: should be "::tk::wayland::decorations window ?server|none?"
wrong # args: should be "::tk::wayland::startmove window"
wrong # args: should be "::tk::wayland::startresize window edge"
bad edge "q": must be n, s, w, nw, sw, e, ne, or se
wrong # args: should be "::tk::wayland::windowmenu window ?x y?"
expected integer but got "a"
expected boolean value but got "maybe"
wrong # args: should be "::tk::wayland::activationtoken"
wrong # args: should be "::tk::wayland::scale window"
wrong # args: should be "::tk::wayland::corners window ?radius?"}
test wayland-14.2 {move, resize and window menu of unshown toplevels} -constraints {
    wayland
} -setup {
    toplevel .t
    wm withdraw .t
    toplevel .u
} -body {
    list [catch {::tk::wayland::startmove .t} m] $m \
	[catch {::tk::wayland::startresize .u se} m] $m \
	[catch {::tk::wayland::windowmenu .t} m] $m
} -cleanup {
    destroy .t .u
} -result {1 {window ".t" is not shown as a toplevel} 1 {window ".u" is not shown as a toplevel} 1 {window ".t" is not shown as a toplevel}}
test wayland-14.3 {move, resize and window menu without a button press} -constraints {
    wayland
} -setup {
    toplevel .t
    waitShown .t
} -body {
    # The compositor ignores them, without closing the connection.
    ::tk::wayland::startmove .t
    foreach edge {n s w nw sw e ne se} {
	::tk::wayland::startresize .t $edge
    }
    ::tk::wayland::windowmenu .t
    ::tk::wayland::windowmenu .t 10 10
    update
    after 100
    stillConnected
} -cleanup {
    destroy .t
} -result 1
test wayland-14.4 {app_id: the class, or set} -constraints {
    wayland
} -setup {
    toplevel .t -class Foo
} -body {
    set result [::tk::wayland::appid .t]
    lappend result [::tk::wayland::appid .t org.example.Foo]
    waitShown .t
    lappend result [::tk::wayland::appid .t org.example.Bar]
    lappend result [::tk::wayland::appid .t {}]
    lappend result [::tk::wayland::appid .t [string repeat x 5000]]
    lappend result [stillConnected]
    destroy .t
    toplevel .t
    lappend result [::tk::wayland::appid .t]
} -cleanup {
    destroy .t
} -match glob -result {Foo org.example.Foo org.example.Bar Foo xxx* 1 Toplevel}
test wayland-14.5 {decorations set before and after the window is shown} -constraints {
    wayland
} -setup {
    toplevel .t
} -body {
    set result [::tk::wayland::decorations .t]
    lappend result [::tk::wayland::decorations .t none]
    waitShown .t
    foreach mode {server none none server} {
	lappend result [::tk::wayland::decorations .t $mode]
	update
    }
    wm withdraw .t
    ::tk::wayland::decorations .t none
    wm deiconify .t
    waitShown .t
    lappend result [::tk::wayland::decorations .t] [stillConnected]
} -cleanup {
    destroy .t
} -result {server none server none none server none 1}
test wayland-14.6 {idle inhibition follows the window} -constraints {
    wayland
} -setup {
    toplevel .t
} -body {
    set result [::tk::wayland::inhibitidle .t]
    lappend result [::tk::wayland::inhibitidle .t yes]
    waitShown .t
    wm withdraw .t
    update
    wm deiconify .t
    waitShown .t
    wm iconify .t
    update
    lappend result [::tk::wayland::inhibitidle .t 0] \
	[::tk::wayland::inhibitidle .t 1]
    destroy .t
    lappend result [stillConnected]
} -cleanup {
    destroy .t
} -result {0 1 0 1 1}
test wayland-14.7 {activation token and scale} -constraints {
    wayland
} -setup {
    toplevel .t
    waitShown .t
} -body {
    # The compositor may give no token.
    set token [::tk::wayland::activationtoken]
    list [string is print $token] [expr {[::tk::wayland::scale .t] > 0}] \
	[stillConnected]
} -cleanup {
    destroy .t
} -result {1 1 1}
test wayland-14.8 {app_id, decorations and idle inhibition in sway} -constraints {
    swayPointer
} -setup {
    toplevel .t
    wm title .t wlcmds
    ::tk::wayland::appid .t org.example.Cmds
    ::tk::wayland::decorations .t none
    ::tk::wayland::inhibitidle .t 1
    waitShown .t
} -body {
    waitFor {[swayField wlcmds border] ni {"" normal}}
    set result [list [swayField wlcmds app_id] \
	[expr {[swayField wlcmds border] in {none csd}}] \
	[swayField wlcmds inhibit_idle]]
    ::tk::wayland::decorations .t server
    ::tk::wayland::inhibitidle .t 0
    ::tk::wayland::appid .t org.example.Other
    waitFor {[swayField wlcmds border] eq "normal"}
    lappend result [swayField wlcmds app_id] [swayField wlcmds border] \
	[swayField wlcmds inhibit_idle]
} -cleanup {
    destroy .t
} -result {org.example.Cmds 1 true org.example.Other normal false}
test wayland-14.9 {move a window by dragging it} -constraints {
    swayPointer
} -setup {
    toplevel .t
    wm title .t wlmove
    ::tk::wayland::decorations .t none
    frame .t.f -width 200 -height 100
    button .t.b -text Click -command {incr ::wlclicked}
    pack .t.f .t.b
    bind .t.f <ButtonPress-1> {::tk::wayland::startmove .t}
    set ::wlclicked 0
    waitShown .t

    # Sway removes its title bar after the window is shown.
    waitFor {[swayField wlmove border] ni {"" normal}}
    after 100
    update
} -body {
    lassign [swayRect wlmove] x0 y0
    pointer "move [expr {$x0 + 20}] [expr {$y0 + 20}]"
    pointer "press 1"
    after 100
    pointer "move [expr {$x0 + 80}] [expr {$y0 + 50}]"
    pointer "move [expr {$x0 + 120}] [expr {$y0 + 70}]"
    pointer "release 1"
    waitFor {[swayRect wlmove] ne [list $x0 $y0]}
    lassign [swayRect wlmove] x1 y1

    # The application has not missed the release of the button: a click
    # works after the move.
    swayClick .t.b 5 5
    waitFor {$::wlclicked}
    # The compositor moves the window by the motion of the pointer, which
    # it may round (sway 1.12 moves it 99 pixels).
    list [expr {abs($x1 - $x0 - 100) <= 1}] [expr {abs($y1 - $y0 - 50) <= 1}] \
	    $::wlclicked
} -cleanup {
    destroy .t
    unset -nocomplain ::wlclicked
} -result {1 1 1}
test wayland-14.10 {resize a window by dragging its corner} -constraints {
    swayPointer
} -setup {
    toplevel .t -width 200 -height 150
    wm title .t wlresize
    ::tk::wayland::decorations .t none
    bind .t <ButtonPress-1> {::tk::wayland::startresize .t se}
    waitShown .t

    # Sway removes its title bar after the window is shown.
    waitFor {[swayField wlresize border] ni {"" normal}}
    after 100
    update
} -body {
    lassign [swayRect wlresize] x0 y0
    set w0 [winfo width .t]
    set h0 [winfo height .t]
    pointer "move [expr {$x0 + $w0 - 2}] [expr {$y0 + $h0 - 2}]"
    pointer "press 1"
    after 100
    pointer "move [expr {$x0 + $w0 + 40}] [expr {$y0 + $h0 + 30}]"
    pointer "move [expr {$x0 + $w0 + 60}] [expr {$y0 + $h0 + 40}]"
    pointer "release 1"
    waitFor {[winfo width .t] != $w0}

    # The size changes by how much the pointer moved, give or take where
    # the compositor measures from.
    list [expr {abs([winfo width .t] - $w0 - 62) <= 3}] \
	[expr {abs([winfo height .t] - $h0 - 42) <= 3}]
} -cleanup {
    destroy .t
} -result {1 1}
test wayland-14.11 {rounded corners: values, and with other settings} -constraints {
    wayland
} -setup {
    toplevel .t -width 100 -height 60
} -body {
    set result [::tk::wayland::corners .t]
    lappend result [::tk::wayland::corners .t 10]
    lappend result [catch {::tk::wayland::corners .t -1} m] $m
    lappend result [catch {::tk::wayland::corners .t big} m]
    ::tk::wayland::decorations .t none
    waitShown .t

    # Larger than the window, translucent, resized, decorated again.
    foreach radius {0 4 200 12} {
	::tk::wayland::corners .t $radius
	update
    }
    wm attributes .t -alpha 0.5
    update
    foreach size {300x200 10x10 1x1 150x90} {
	wm geometry .t $size
	update
    }
    wm attributes .t -alpha 1.0
    ::tk::wayland::decorations .t server
    update
    ::tk::wayland::decorations .t none
    wm attributes .t -fullscreen 1
    update
    wm attributes .t -fullscreen 0
    update
    lappend result [::tk::wayland::corners .t] [stillConnected]
} -cleanup {
    destroy .t
} -result {0 10 1 {bad radius "-1": must be a non-negative distance} 1 12 1}
test wayland-14.12 {rounded corners are transparent} -constraints {
    swayPointer
} -setup {
    # The main window could be over the window.
    wm withdraw .
    toplevel .t -width 200 -height 120 -background red
    wm title .t wlcorners
    ::tk::wayland::decorations .t none
    waitShown .t
    waitFor {[swayField wlcorners border] ni {"" normal}}
    after 100
    update

    # The color of a pixel of the screen.
    proc pixel {x y} {
	set f [open "|grim -g \"$x,$y 1x1\" -t ppm -" rb]
	set data [read $f]
	close $f
	binary scan [string range $data end-2 end] cu3 rgb
	return $rgb
    }
} -body {
    lassign [swayRect wlcorners] x y
    waitFor {[pixel [expr {$x + 100}] [expr {$y + 60}]] eq {255 0 0}}
    set result [list [pixel $x $y] [pixel [expr {$x + 100}] [expr {$y + 60}]]]
    ::tk::wayland::corners .t 16
    update
    after 200
    update
    lappend result [pixel $x $y] [pixel [expr {$x + 199}] [expr {$y + 119}]] \
	[pixel [expr {$x + 100}] [expr {$y + 1}]]

    # Square again when the window has decorations.
    ::tk::wayland::decorations .t server
    waitFor {[swayField wlcorners border] eq "normal"}
    after 200
    update
    lassign [swayRect wlcorners] x y
    lappend result [pixel $x $y]
} -cleanup {
    destroy .t
    rename pixel {}
    wm deiconify .
} -result {{255 0 0} {255 0 0} {0 0 0} {0 0 0} {255 0 0} {255 0 0}}
test wayland-15.1 {tk::ScrollByPixels scrolls by pixels of the content} -setup {
    toplevel .t
    canvas .t.c -width 200 -height 100 -scrollregion {0 0 600 400} \
	-borderwidth 0 -highlightthickness 0 \
	-xscrollincrement 1 -yscrollincrement 1
    pack .t.c
    update
} -body {
    # The content is 3 times as wide and 4 times as high as the window.
    tk::ScrollByPixels .t.c -30 -40
    set result [list [.t.c canvasx 0] [.t.c canvasy 0]]
    tk::ScrollByPixels .t.c 10 25
    lappend result [.t.c canvasx 0] [.t.c canvasy 0]
} -cleanup {
    destroy .t
} -result {30.0 40.0 20.0 15.0}
test wayland-15.2 {scrolling with fingers follows the fingers} -constraints {
    swayPointer
} -setup {
    toplevel .t
    wm title .t wlfscroll
    canvas .t.c -width 300 -height 200 -scrollregion {0 0 900 800} \
	-borderwidth 0 -highlightthickness 0 -yscrollincrement 1
    pack .t.c
    bind .t.c <TouchpadScroll> {
	lassign [tk::PreciseScrollDeltas %D] deltaX deltaY
	tk::ScrollByPixels %W $deltaX $deltaY
    }
    waitShown .t
} -body {
    # Come from outside the window, so that it gets the pointer.
    lassign [swayRect wlfscroll] x y
    bind .t.c <Enter> {set ::wlEntered 1}
    set ::wlEntered 0
    pointer "move [expr {$x - 20}] [expr {$y - 20}]"
    pointer "move [expr {$x + 150}] [expr {$y + 100}]"
    waitFor {$::wlEntered} 1000
    foreach i {1 2 3 4 5} {
	pointer "fscroll 10"
    }
    waitFor {[.t.c canvasy 0] >= 50} 1000
    .t.c canvasy 0
} -cleanup {
    destroy .t
    unset -nocomplain ::wlEntered
} -result 50.0
test wayland-15.3 {the on-screen keyboard stays up between text widgets} -constraints {
    swayInputMethod
} -setup {
    set im [open |$::env(TK_WAYLAND_INPUT_METHOD) r+]
    fconfigure $im -blocking 0 -buffering line
    set ::wlim {}
    fileevent $im readable [list apply {{im} {
	while {[gets $im line] >= 0} {
	    lappend ::wlim $line
	}
    }} $im]
    waitFor {"ready" in $::wlim}
    toplevel .t
    text .t.a -width 20 -height 3
    text .t.b -width 20 -height 3
    entry .t.e
    button .t.x -text Button
    pack .t.a .t.b .t.e .t.x
    waitShown .t
} -body {
    foreach w {.t.a .t.b .t.a .t.e .t.a .t.x .t.b} {
	focus -force $w
	update
	after 400
	update
	lappend ::wlim ($w)
    }
    lrange $::wlim [lsearch $::wlim ready]+1 end
} -cleanup {
    destroy .t
    close $im
    unset -nocomplain ::wlim
} -result {activate (.t.a) (.t.b) (.t.a) (.t.e) (.t.a) (.t.x) deactivate activate (.t.b)}
}

