<?xml version="1.0" encoding="utf-8"?>
<!--
  The theme of the activity. Android 15 draws the windows of applications
  which target it under the system bars, unless they opt out: Tk gets the
  part of the window not covered by the bars and the soft keyboard from the
  content rectangle of the NativeActivity, which needs the window to be laid
  out within them.
-->
<resources>
  <style name="Tk" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
  </style>
</resources>
